NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Temporary Atlas maintenance user. Keep the URI blank in tracked files.
# Copy this file to .env.maintenance.local and delete it when maintenance ends.
DATABASE_DRIVER=mongodb
DATABASE_ENVIRONMENT=development
DATABASE_ACCESS_MODE=maintenance
MONGODB_URI=
MONGODB_DB_NAME=gradport_dev
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=5

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.local-data/storage

EMAIL_DRIVER=console
READY_CHECK_TIMEOUT_MS=2000

{
  "name": "gradport-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated MongoDB persistence foundation for GradPort.",
  "type": "module",
  "engines": {
    "node": ">=22.15.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:atlas": "node --env-file=.env.development.local --import tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=1",
    "test:unit": "vitest run --exclude tests/integration/** --maxWorkers=1",
    "test:integration": "vitest run tests/integration --maxWorkers=1",
    "db:ping": "node --env-file=.env.development.local --import tsx src/database/diagnostics/ping-database.ts",
    "db:migrate": "node --env-file=.env.maintenance.local --import tsx src/database/migrations/run-migrations.ts",
    "db:migrate:status": "node --env-file=.env.maintenance.local --import tsx src/database/migrations/show-migration-status.ts",
    "db:seed": "node --env-file=.env.maintenance.local --import tsx src/database/seeds/run-seeds.ts",
    "db:verify": "node --env-file=.env.maintenance.local --import tsx src/database/diagnostics/verify-database.ts",
    "seed": "node --env-file=.env.maintenance.local --import tsx src/database/seeds/run-seeds.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "argon2": "^0.45.1",
    "fastify": "^5.6.2",
    "mongodb": "~7.5.0",
    "mongoose": "^9.0.0",
    "nodemailer": "^10.0.1",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.9.1",
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.4"
  }
}

{
  "name": "gradport-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated Phase 1 backend foundation for GradPort.",
  "type": "module",
  "engines": {
    "node": ">=22.15.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed": "tsx src/database/seeds/run-seeds.ts"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "mongoose": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.9.1",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.4"
  }
}

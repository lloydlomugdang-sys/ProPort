NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Runtime connection example. Keep MONGODB_URI blank in tracked files.
# Copy this file to .env.development.local before configuring Atlas manually.
DATABASE_DRIVER=mock
DATABASE_ENVIRONMENT=development
DATABASE_ACCESS_MODE=runtime
MONGODB_URI=
MONGODB_DB_NAME=gradport_dev
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=10

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.local-data/storage

EMAIL_DRIVER=console
CONSOLE_EMAIL_PREVIEW=false

# Required only when EMAIL_DRIVER=smtp. Keep credentials in ignored environment
# files or the deployment secret store; never commit real values.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Required to start the API outside tests. Generate two independent random
# values of at least 32 bytes and keep them only in an ignored local/production
# secret store. Never reuse the MongoDB password.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=gradport-api
AUTH_JWT_AUDIENCE=gradport-mobile
AUTH_CODE_PEPPER=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=600
AUTH_RESET_GRANT_TTL_SECONDS=600
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60
AUTH_CODE_MAX_ATTEMPTS=5

# Keep false for direct/local deployments. Behind a trusted reverse proxy,
# use an exact hop count or comma-separated proxy IPs/CIDRs. `true` is rejected.
TRUST_PROXY=false
READY_CHECK_TIMEOUT_MS=2000

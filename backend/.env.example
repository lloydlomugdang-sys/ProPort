NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Use "mock" until a local or managed MongoDB server is explicitly configured.
DATABASE_DRIVER=mock
MONGODB_URI=
MONGODB_DB_NAME=gradport

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.local-data/storage

EMAIL_DRIVER=console
READY_CHECK_TIMEOUT_MS=2000
